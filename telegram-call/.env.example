# Тот же ключ доступа, что и у основного сервера Jarvis.
APP_ACCESS_TOKEN=

# Данные приложения Telegram с my.telegram.org для аккаунта-помощника.
TG_API_ID=
TG_API_HASH=

# Строка сессии аккаунта-помощника. Получается один раз локально:
#   python tools/telegram-session.py
# Это полный доступ к аккаунту — хранить только здесь, в переменных окружения.
TG_SESSION=

# Кому звонить: ваш @username или числовой id.
TG_TARGET=

# Голос и модель озвучки OpenAI для реплики в звонке.
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Предохранители: максимум звонков в сутки и длительность одного звонка.
MAX_CALLS_PER_DAY=6
MAX_CALL_SECONDS=90
