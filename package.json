{
  "name": "kamron-app",
  "version": "1.2.5",
  "private": true,
  "description": "Kamron APP — режим дня, который держит: честное время, питомец с характером, фокус-режим и напоминания. PWA.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "icons": "node tools/icons.mjs",
    "serve": "node tools/serve.mjs",
    "format": "prettier --write \"**/*.{js,mjs,css,html,json,md}\"",
    "check": "node tools/check.mjs",
    "test": "node tests/e2e.mjs",
    "test:setup": "npx playwright install chromium",
    "dist-check": "node tools/dist-check.mjs"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "prettier": "^3.9.0",
    "sharp": "^0.34.0",
    "playwright": "^1.56.0"
  }
}
