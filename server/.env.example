# Ключ доступа к этому серверу. Придумайте длинную случайную строку и
# впишите её же в приложении: Настройки → Дополнительно → Подключение Jarvis.
# Без него любой, кто узнает адрес сервиса, потратит ваши лимиты у модели.
APP_ACCESS_TOKEN=

# Откуда разрешены запросы. Через запятую, без завершающего слэша.
ALLOWED_ORIGINS=https://kslmvv.github.io,http://localhost:4173

# Провайдер модели: anthropic или openai.
LLM_PROVIDER=anthropic

# Ключ соответствующего провайдера. Нужен только один из двух.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Модель. Значения по умолчанию заданы в коде, меняйте при смене линейки.
# LLM_MODEL=gpt-5-mini

# Рассуждения GPT-5 по умолчанию «medium» и оплачиваются как выходные токены.
# Для коротких ответов помощника это лишние деньги.
OPENAI_REASONING_EFFORT=minimal

# Цены провайдера за 1 млн токенов — по ним считается расход.
# Значения ниже соответствуют gpt-5-mini; сверяйте при смене модели.
PRICE_INPUT_PER_M=0.25
PRICE_OUTPUT_PER_M=2

# Дневной предел расходов на модель в долларах. 0 отключает ограничение.
# При исчерпании запросы отклоняются до следующих суток.
DAILY_USD_LIMIT=0.15

# Токен GitHub с правом чтения нужных репозиториев (fine-grained, только Contents: Read).
# Нужен для закрытых репозиториев; публичные читаются и без него.
GITHUB_TOKEN=

# Токен Railway для статуса деплоев (Account token в настройках Railway).
RAILWAY_TOKEN=

# Порт задаёт Railway сам, локально можно не указывать.
# PORT=8080
